// Veritabanı şeması.
// Geliştirme için SQLite kullanılıyor. Canlıya alırken provider'ı "postgresql"
// yapıp DATABASE_URL'i Postgres bağlantı adresinle değiştirmen yeterli
// (örn. Supabase, Neon veya Vercel Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Int         // kuruş cinsinden (örn. 129900 = 1299.00 TL)
  stock       Int         @default(0)
  images      String      // JSON string array
  color       String?
  material    String?
  featured    Boolean     @default(false)
  active      Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  customerName  String
  email         String
  phone         String
  address       String
  city          String
  totalAmount   Int         // kuruş
  status        String      @default("BEKLEMEDE")
  paymentRef    String?     // iyzico işlem referansı
  cargoFirma    String?     @default("Aras Kargo")
  takipNo       String?     // Aras Kargo takip numarası
  kargoDurumu   String?     @default("HAZIRLANIYOR")
  items         OrderItem[]
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int     // sipariş anındaki birim fiyat (kuruş)
}

model Admin {
  id       String @id @default(cuid())
  email    String @unique
  password String // bcrypt hash
}
